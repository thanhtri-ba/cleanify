import 'dart:math' as math;

import 'package:flutter/material.dart';
import 'package:photo_manager/photo_manager.dart';

Future<PermissionState> _defaultRequest() =>
    PhotoManager.requestPermissionExtend();
Future<void> _defaultOpenSettings() => PhotoManager.openSetting();

enum _Perm { initial, requesting, denied }

// ---------------------------------------------------------------------------
// Bento Pop: màu rực cố định ở cả hai theme; nền/chữ đổi theo theme.
// Chữ trên violet là trắng; chữ trên amber/azure/lime là gần đen (đủ 4.5:1).
// ---------------------------------------------------------------------------
const Color kOnboardingAccent = Color(0xFF7C4DFF); // violet
const Color _amber = Color(0xFFFFB800);
const Color _azure = Color(0xFF2AA1F5);
const Color _lime = Color(0xFFB4FF3C);
const Color _onBright = Color(0xFF0B0B0C);
const Color _onViolet = Color(0xFFFFFFFF);

class _Palette {
  const _Palette({
    required this.ground,
    required this.surface,
    required this.raised,
    required this.line,
    required this.ink,
    required this.inkMuted,
  });
  final Color ground, surface, raised, line, ink, inkMuted;

  static const dark = _Palette(
    ground: Color(0xFF000000),
    surface: Color(0xFF111113),
    raised: Color(0xFF1C1C20),
    line: Color(0xFF2B2B31),
    ink: Color(0xFFFFFFFF),
    inkMuted: Color(0xFFA3A3AD),
  );
  static const light = _Palette(
    ground: Color(0xFFF3F1EC),
    surface: Color(0xFFFFFFFF),
    raised: Color(0xFFE9E6DF),
    line: Color(0xFFD8D4CB),
    ink: Color(0xFF0B0B0C),
    inkMuted: Color(0xFF585862),
  );
}

/// Số liệu và tiêu đề: Unbounded (variable font). Nếu chưa bundle font vào
/// assets thì Flutter tự rơi về font hệ thống, giao diện vẫn đúng bố cục.
TextStyle _display(double size, double lineHeight, int weight, Color color) =>
    TextStyle(
      fontFamily: 'Unbounded',
      fontSize: size,
      height: lineHeight / size,
      color: color,
      fontWeight: FontWeight.values[weight ~/ 100 - 1],
      fontVariations: [FontVariation('wght', weight.toDouble())],
      letterSpacing: size * -0.01,
    );

TextStyle _text(double size, double lineHeight, int weight, Color color) =>
    TextStyle(
      fontSize: size,
      height: lineHeight / size,
      color: color,
      fontWeight: FontWeight.values[weight ~/ 100 - 1],
    );

/// Onboarding 3 bước + màn xin quyền Ảnh. Không lưu cờ "đã xem" xuống đĩa
/// (app stateless): nơi gọi quyết định có hiển thị hay không.
class OnboardingFlow extends StatefulWidget {
  const OnboardingFlow({
    super.key,
    required this.onFinished,
    this.requestPermission = _defaultRequest,
    this.openSettings = _defaultOpenSettings,
  });

  final VoidCallback onFinished;
  final Future<PermissionState> Function() requestPermission;
  final Future<void> Function() openSettings;

  @override
  State<OnboardingFlow> createState() => _OnboardingFlowState();
}

class _OnboardingFlowState extends State<OnboardingFlow> {
  static const int _permStep = 3;
  int _step = 0;
  _Perm _perm = _Perm.initial;

  void _go(int step) => setState(() => _step = step);

  Future<void> _allow() async {
    if (_perm == _Perm.requesting) return;
    setState(() => _perm = _Perm.requesting);
    PermissionState result;
    try {
      result = await widget.requestPermission();
    } catch (_) {
      result = PermissionState.denied;
    }
    if (!mounted) return;
    if (result.hasAccess) {
      widget.onFinished();
    } else {
      setState(() => _perm = _Perm.denied);
    }
  }

  @override
  Widget build(BuildContext context) {
    final dark = Theme.of(context).brightness == Brightness.dark;
    final p = dark ? _Palette.dark : _Palette.light;
    return Scaffold(
      backgroundColor: p.ground,
      body: SafeArea(
        child: AnimatedSwitcher(
          duration: const Duration(milliseconds: 250),
          child: KeyedSubtree(
            key: ValueKey(_step),
            child: _step == _permStep ? _permissionPage(p) : _introPage(p),
          ),
        ),
      ),
    );
  }

  // ---- intro (3 bước) ----
  static const _intro = <_IntroData>[
    _IntroData(
      title: 'Dọn ảnh trùng, nhẹ máy ngay',
      body: 'Cleanify tìm những ảnh giống nhau trong thư viện để bạn giải '
          'phóng dung lượng.',
      cta: 'Bắt đầu',
    ),
    _IntroData(
      title: 'Giữ bản đẹp nhất, bỏ bản trùng',
      body: 'Ảnh giống nhau được gom thành nhóm. Bạn xem và chọn, chỉ xóa '
          'khi bạn xác nhận.',
      cta: 'Tiếp tục',
    ),
    _IntroData(
      title: 'Ảnh của bạn ở lại trên máy',
      body: 'Việc quét và so sánh diễn ra ngay trên điện thoại. Mọi thao tác '
          'xóa đều hỏi bạn trước.',
      cta: 'Tiếp tục',
    ),
  ];

  Widget _introPage(_Palette p) {
    final d = _intro[_step];
    return Padding(
      padding: const EdgeInsets.fromLTRB(16, 8, 16, 20),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          SizedBox(
            height: 44,
            child: Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                Row(children: [
                  Container(
                    width: 36,
                    height: 36,
                    decoration: const BoxDecoration(
                        color: kOnboardingAccent, shape: BoxShape.circle),
                    child: const Icon(Icons.auto_awesome_outlined,
                        size: 20, color: _onViolet),
                  ),
                  const SizedBox(width: 10),
                  Text('Cleanify', style: _display(18, 24, 500, p.ink)),
                ]),
                if (_step < 2)
                  TextButton(
                    onPressed: () => _go(_permStep),
                    style: TextButton.styleFrom(
                      minimumSize: const Size(44, 44),
                      foregroundColor: p.inkMuted,
                      textStyle: const TextStyle(
                          fontSize: 13, fontWeight: FontWeight.w600),
                    ),
                    child: const Text('Bỏ qua'),
                  ),
              ],
            ),
          ),
          Expanded(
            child: Center(
              child: FittedBox(
                fit: BoxFit.scaleDown,
                child: SizedBox(width: 358, child: _hero(p)),
              ),
            ),
          ),
          const SizedBox(height: 24),
          Text(d.title, style: _display(24, 30, 500, p.ink)),
          const SizedBox(height: 12),
          Text(d.body, style: _text(15, 22, 400, p.inkMuted)),
          const SizedBox(height: 24),
          _SegmentBar(step: _step),
          const SizedBox(height: 20),
          _PrimaryButton(
            label: d.cta,
            trailing: Icons.arrow_forward_rounded,
            onPressed: () => _go(_step + 1),
          ),
          const SizedBox(height: 4),
          SizedBox(
            height: 44,
            child: _step > 0
                ? TextButton(
                    onPressed: () => _go(_step - 1),
                    style: TextButton.styleFrom(
                      foregroundColor: p.inkMuted,
                      textStyle: const TextStyle(
                          fontSize: 15, fontWeight: FontWeight.w600),
                    ),
                    child: const Text('Quay lại'),
                  )
                : null,
          ),
        ],
      ),
    );
  }

  Widget _hero(_Palette p) {
    switch (_step) {
      case 0:
        return _heroWelcome();
      case 1:
        return _heroGroup(p);
      default:
        return _heroPrivacy(p);
    }
  }

  static const _quarter = BorderRadius.only(
    topLeft: Radius.circular(28),
    topRight: Radius.circular(28),
    bottomLeft: Radius.circular(28),
    bottomRight: Radius.circular(96),
