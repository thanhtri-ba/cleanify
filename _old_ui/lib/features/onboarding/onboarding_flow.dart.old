class _IntroData {
  const _IntroData({
    required this.title,
    required this.body,
    required this.cta,
  });
  final String title;
  final String body;
  final String cta;
}

// ---------------------------------------------------------------------------
// Thành phần Bento Pop
// ---------------------------------------------------------------------------

/// Vòng đồng mức từ góc trên phải (hoặc từ tâm với [center]), mờ dần.
class _Contour extends CustomPainter {
  const _Contour({required this.color, this.center = false});
  final Color color;
  final bool center;

  @override
  void paint(Canvas canvas, Size size) {
    final diag = math.sqrt(size.width * size.width + size.height * size.height);
    final origin =
        center ? Offset(size.width / 2, size.height / 2) : Offset(size.width, 0);
    final far = center ? diag / 2 : diag;
    final paint = Paint()
      ..style = PaintingStyle.stroke
      ..strokeWidth = 1;
    for (double r = 10; r < far; r += 10) {
      final t = r / far;
      final a = center
          ? ((t - 0.4) / 0.6).clamp(0.0, 1.0)
          : (1 - t / 0.7).clamp(0.0, 1.0);
      if (a <= 0) continue;
      paint.color = color.withAlpha((255 * 0.22 * a).round());
      canvas.drawCircle(origin, r, paint);
    }
  }

  @override
  bool shouldRepaint(covariant _Contour old) =>
      old.color != color || old.center != center;
}

class _Tile extends StatelessWidget {
  const _Tile({
    required this.bg,
    required this.fg,
    required this.child,
    this.height,
    this.radius = const BorderRadius.all(Radius.circular(28)),
    this.oval = false,
    this.rings = true,
    this.padding = 20,
  });

  final Color bg;
  final Color fg;
  final Widget child;
  final double? height;
  final BorderRadius radius;
  final bool oval;
  final bool rings;
  final double padding;

  @override
  Widget build(BuildContext context) {
    final body = Stack(children: [
      Positioned.fill(child: ColoredBox(color: bg)),
      if (rings)
        Positioned.fill(
          child: IgnorePointer(
            child: CustomPaint(painter: _Contour(color: fg, center: oval)),
          ),
        ),
      Positioned.fill(
        child: Padding(
          padding: EdgeInsets.all(padding),
          child: DefaultTextStyle.merge(style: TextStyle(color: fg), child: child),
        ),
      ),
    ]);
    final shaped = oval
        ? ClipOval(child: body)
        : ClipRRect(borderRadius: radius, child: body);
    return height == null ? shaped : SizedBox(height: height, child: shaped);
  }
}

class _IconDisc extends StatelessWidget {
  const _IconDisc({
    required this.icon,
    required this.color,
    this.size = 40,
    this.iconSize = 24,
  });
  final IconData icon;
  final Color color;
  final double size;
  final double iconSize;

  @override
  Widget build(BuildContext context) {
    return Container(
      width: size,
      height: size,
      decoration: BoxDecoration(
        color: color.withAlpha(36),
        shape: BoxShape.circle,
      ),
      child: Icon(icon, size: iconSize, color: color),
    );
  }
}

/// Một ô, một con số: icon trên, số lớn và nhãn dưới.
class _TileBody extends StatelessWidget {
  const _TileBody({
    this.icon,
    required this.value,
    required this.label,
    this.unit,
    this.big = false,
    this.centered = false,
    this.labelColor,
  });
  final IconData? icon;
  final String value;
  final String? unit;
  final String label;
  final bool big;
  final bool centered;
  final Color? labelColor;

  @override
  Widget build(BuildContext context) {
    final fg = DefaultTextStyle.of(context).style.color ?? _onBright;
    final metric = Column(
      mainAxisSize: MainAxisSize.min,
      crossAxisAlignment:
          centered ? CrossAxisAlignment.center : CrossAxisAlignment.start,
      children: [
        Text.rich(
          TextSpan(children: [
            TextSpan(
              text: value,
              style: big ? _display(44, 46, 600, fg) : _display(28, 32, 600, fg),
            ),
            if (unit != null)
              TextSpan(
                text: ' $unit',
                style: _display(14, 18, 400, fg),
              ),
          ]),
          textAlign: centered ? TextAlign.center : TextAlign.start,
        ),
        SizedBox(height: big ? 4 : 2),
        Text(
          label,
          textAlign: centered ? TextAlign.center : TextAlign.start,
          style: _text(13, 18, 500, labelColor ?? fg),
        ),
      ],
    );
    if (centered) return Center(child: metric);
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      mainAxisAlignment: MainAxisAlignment.spaceBetween,
      children: [
        if (icon != null) _IconDisc(icon: icon!, color: fg) else const SizedBox(),
        metric,
      ],
    );
  }
}

/// Ảnh minh họa phẳng (mặt trời + đồi) cho nhóm ảnh trùng.
class _ScenePainter extends CustomPainter {
  const _ScenePainter(
      {required this.bg, required this.sun, required this.hills});
  final Color bg, sun, hills;

  @override
  void paint(Canvas canvas, Size size) {
    final s = size.width / 100;
    canvas.drawRect(Offset.zero & size, Paint()..color = bg);
    canvas.drawCircle(Offset(70 * s, 30 * s), 10 * s, Paint()..color = sun);
    final path = Path()
      ..moveTo(0, 78 * s)
      ..lineTo(28 * s, 46 * s)
      ..lineTo(48 * s, 66 * s)
      ..lineTo(66 * s, 48 * s)
      ..lineTo(100 * s, 80 * s)
      ..lineTo(100 * s, 100 * s)
      ..lineTo(0, 100 * s)
      ..close();
    canvas.drawPath(path, Paint()..color = hills);
  }

  @override
  bool shouldRepaint(covariant _ScenePainter old) => false;
}

class _Thumb extends StatelessWidget {
  const _Thumb({
    required this.bg,
    required this.sun,
    required this.hills,
    this.keep = false,
  });
  final Color bg, sun, hills;
  final bool keep;

  @override
  Widget build(BuildContext context) {
    return Column(children: [
      Semantics(
        label: keep ? 'Ảnh minh họa, bản được giữ' : 'Ảnh minh họa, bản trùng',
        image: true,
        child: AspectRatio(
          aspectRatio: 1,
          child: ClipRRect(
            borderRadius: BorderRadius.circular(12),
            child: CustomPaint(
                painter: _ScenePainter(bg: bg, sun: sun, hills: hills)),
          ),
        ),
      ),
      const SizedBox(height: 8),
      Container(
        height: 24,
        alignment: Alignment.center,
        decoration: BoxDecoration(
          color: keep ? _lime : kOnboardingAccent,
          borderRadius: BorderRadius.circular(999),
        ),
        child: Row(mainAxisSize: MainAxisSize.min, children: [
          if (keep) ...const [
            Icon(Icons.check_rounded, size: 14, color: _onBright),
            SizedBox(width: 4),
          ],
          Text(keep ? 'Giữ' : 'Trùng',
              style: _text(12, 16, 600, keep ? _onBright : _onViolet)),
        ]),
      ),
    ]);
  }
}

class _ReasonRow extends StatelessWidget {
  const _ReasonRow({
    required this.p,
    required this.icon,
    required this.title,
    required this.caption,
  });
  final _Palette p;
  final IconData icon;
  final String title;
  final String caption;

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 14),
      child: Row(children: [
        _IconDisc(icon: icon, color: p.ink, iconSize: 22),
        const SizedBox(width: 12),
        Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(title, style: _text(15, 22, 600, p.ink)),
              Text(caption, style: _text(13, 18, 400, p.inkMuted)),
            ],
          ),
        ),
      ]),
    );
  }
}

class _SegmentBar extends StatelessWidget {
  const _SegmentBar({required this.step});
  final int step;

  @override
  Widget build(BuildContext context) {
    final on = Theme.of(context).brightness == Brightness.dark
        ? _Palette.dark.ink
        : _Palette.light.ink;
    return Semantics(
      label: 'Bước ${step + 1} trên 3',
      child: Row(children: [
        for (var i = 0; i < 3; i++) ...[
          if (i > 0) const SizedBox(width: 4),
          Expanded(
            child: AnimatedContainer(
              duration: const Duration(milliseconds: 250),
              height: 4,
              decoration: BoxDecoration(
                borderRadius: BorderRadius.circular(999),
                color: i <= step ? on : on.withAlpha(71),
              ),
            ),
          ),
        ],
      ]),
    );
  }
}

class _PrimaryButton extends StatelessWidget {
  const _PrimaryButton({
    required this.label,
    required this.onPressed,
    this.busy = false,
    this.trailing,
  });
  final String label;
  final VoidCallback? onPressed;
  final bool busy;
  final IconData? trailing;

  @override
  Widget build(BuildContext context) {
    return SizedBox(
      height: 56,
      child: FilledButton(
        onPressed: busy ? null : onPressed,
        style: FilledButton.styleFrom(
          backgroundColor: kOnboardingAccent,
          foregroundColor: _onViolet,
          disabledBackgroundColor: kOnboardingAccent,
          disabledForegroundColor: _onViolet,
          shape: const StadiumBorder(),
          textStyle: const TextStyle(fontSize: 15, fontWeight: FontWeight.w600),
        ),
        child: busy
            ? const SizedBox(
                width: 20,
                height: 20,
                child: CircularProgressIndicator(
                    strokeWidth: 2, color: _onViolet),
              )
            : Row(
                mainAxisSize: MainAxisSize.min,
                children: [
                  Text(label),
                  if (trailing != null) ...[
                    const SizedBox(width: 8),
                    Icon(trailing, size: 20),
                  ],
                ],
              ),
      ),
    );
  }
}
