            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: const [
                Icon(Icons.auto_awesome_outlined,
                    size: 32, color: Color(0xFF8A6CF5)),
                SizedBox(height: 16),
                Text(
                  'Cleanify',
                  style: TextStyle(
